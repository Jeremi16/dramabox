# DramaBox Lite - Environment Variables

# API Configuration
# Base URL untuk Dramabox API
# Default: https://dramabox-api.zone.id
VITE_DRAMABOX_API_BASE_URL=https://dramabox-api.zone.id

# Base URL untuk Melolo API
# Default: https://melolo-api-azure.vercel.app
VITE_MELOLO_API_BASE_URL=https://melolo-api-azure.vercel.app

# Note:
# - API ini adalah public API (tidak perlu API key)
# - Dokumentasi: https://dramabox-api.zone.id/
