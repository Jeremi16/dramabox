/* Modern Layout */
.app-shell {
  max-width: 1400px;
  margin: 0 auto;
  padding: 24px;
}

.dashboard-layout {
  min-height: calc(100vh - 48px);
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 24px;
}

/* Sidebar */
.sidebar {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.brand-block {
  padding: 16px 0;
}

.brand-block h1 {
  margin: 0 0 4px 0;
  font-size: 20px;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}

.brand-badge {
  display: inline-block;
  margin: 0;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--accent-primary);
  background: var(--accent-light);
  border-radius: 4px;
  padding: 4px 8px;
}

.brand-subtitle {
  margin: 8px 0 0 0;
  color: var(--text-secondary);
  font-size: 13px;
  line-height: 1.5;
  font-weight: 400;
}

/* Navigation */
.sidebar-nav,
.tabs {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.tab {
  display: flex;
  align-items: center;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  border: none;
  cursor: pointer;
  transition: all 0.15s ease;
}

.tab:hover {
  background: var(--bg-tertiary);
  color: var(--text-primary);
}

.tab.active {
  background: var(--accent-primary);
  color: white;
  font-weight: 600;
}

/* Following Card */
.following-card {
  margin-top: auto;
  padding: 16px;
  border-radius: var(--radius-md);
  background: var(--bg-primary);
  border: 1px solid var(--border-light);
}

.following-card h3 {
  margin: 0 0 12px 0;
  font-size: 13px;
  color: var(--text-secondary);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.following-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.following-item {
  display: flex;
  align-items: center;
  gap: 10px;
}

.following-item span {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 600;
  color: white;
  background: linear-gradient(135deg, var(--accent-primary), var(--accent-hover));
}

.following-item small {
  color: var(--text-secondary);
  font-size: 13px;
  font-weight: 500;
}

/* Main Area */
.main-area {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

/* Topbar */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.search-form {
  display: flex;
  gap: 8px;
  flex: 1;
  max-width: 600px;
}

.search-form input {
  flex: 1;
  border: 1px solid var(--border-light);
  border-radius: var(--radius-sm);
  background: var(--bg-primary);
  padding: 10px 14px;
  color: var(--text-primary);
  font-family: inherit;
  font-size: 14px;
  transition: all 0.15s ease;
}

.search-form input:focus {
  outline: none;
  border-color: var(--accent-primary);
  box-shadow: 0 0 0 3px var(--accent-light);
}

.search-form input::placeholder {
  color: var(--text-tertiary);
}

.search-form button,
.page-controls button {
  border: 1px solid var(--border-light);
  border-radius: var(--radius-sm);
  padding: 10px 16px;
  background: var(--bg-primary);
  color: var(--text-primary);
  cursor: pointer;
  transition: all 0.15s ease;
  font-weight: 500;
  font-size: 14px;
  font-family: inherit;
}

.search-form button:hover,
.page-controls button:hover {
  border-color: var(--border-medium);
  background: var(--bg-tertiary);
}

.search-form button:active,
.page-controls button:active {
  transform: scale(0.98);
}

.user-chip {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 14px;
  color: white;
  background: linear-gradient(135deg, var(--accent-primary), var(--accent-hover));
  cursor: pointer;
  transition: transform 0.15s ease;
}

.user-chip:hover {
  transform: scale(1.05);
}

/* Content Area */
.content-area {
  min-width: 0;
}

.page-panel,
.catalog-panel,
.watch-panel {
  border-radius: var(--radius-lg);
  background: var(--bg-primary);
  padding: 24px;
  border: 1px solid var(--border-light);
}

.panel-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border-light);
}

.panel-heading h2 {
  margin: 0;
  font-size: 20px;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}

.page-controls {
  display: flex;
  gap: 8px;
  align-items: center;
}

.page-controls span {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-secondary);
  margin: 0 4px;
}

/* Card Grid */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 20px;
}

.series-card {
  border-radius: var(--radius-md);
  background: var(--bg-primary);
  cursor: pointer;
  display: flex;
  flex-direction: column;
  transition: all 0.2s ease;
  overflow: hidden;
  border: 1px solid var(--border-light);
}

.series-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
  border-color: var(--border-medium);
}

.poster-wrap {
  width: 100%;
  aspect-ratio: 2/3;
  overflow: hidden;
  background: var(--bg-tertiary);
}

.poster-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.series-card-content {
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}

.series-card h3 {
  margin: 0;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.series-card p {
  margin: 0;
  color: var(--text-secondary);
  font-size: 12px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.5;
}

.meta {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font-size: 11px;
  font-weight: 500;
  color: var(--text-tertiary);
  padding-top: 8px;
  border-top: 1px solid var(--border-light);
}

/* Error & Messages */
.error-banner {
  margin: 16px 0;
  padding: 12px 16px;
  border-radius: var(--radius-sm);
  color: #991b1b;
  border: 1px solid #fecaca;
  background: #fef2f2;
  font-weight: 500;
  font-size: 14px;
}

.muted {
  color: var(--text-tertiary);
  font-size: 14px;
}

/* Episode Buttons */
.episode-btn {
  border: 1px solid var(--border-light);
  border-radius: var(--radius-sm);
  padding: 10px 16px;
  background: var(--bg-primary);
  color: var(--text-primary);
  cursor: pointer;
  transition: all 0.15s ease;
  font-weight: 500;
  font-size: 14px;
  font-family: inherit;
}

.episode-btn:hover {
  border-color: var(--border-medium);
  background: var(--bg-tertiary);
}

.episode-btn.active {
  border-color: var(--accent-primary);
  background: var(--accent-primary);
  color: white;
}

/* Responsive */
@media (max-width: 1024px) {
  .dashboard-layout {
    grid-template-columns: 1fr;
  }

  .sidebar {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .following-card {
    display: none;
  }

  .sidebar-nav {
    flex-direction: row;
    flex-wrap: wrap;
  }
}

@media (max-width: 768px) {
  .app-shell {
    padding: 16px;
  }

  .topbar {
    flex-direction: column;
    align-items: stretch;
  }

  .search-form {
    max-width: none;
  }

  .panel-heading {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .card-grid {
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
  }
}

@media (max-width: 480px) {
  .app-shell {
    padding: 12px;
  }

  .page-panel,
  .catalog-panel {
    padding: 16px;
  }

  .card-grid {
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 12px;
  }
}
